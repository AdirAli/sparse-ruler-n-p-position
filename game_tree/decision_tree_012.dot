digraph G {
  rankdir=TB;
  node [shape=box, fontsize=10];
  n0 [label="∅\nN"];
  n1 [label="0\nP"];
  n2 [label="01\nN"];
  n3 [label="012\nP", style=filled, fillcolor=yellow];
  n4 [label="02\nN"];
  n5 [label="1\nP"];
  n6 [label="12\nN"];
  n7 [label="2\nP"];

  n0 -> n1 [color=green, penwidth=2.0];
  n0 -> n5 [color=green, penwidth=2.0];
  n0 -> n7 [color=green, penwidth=2.0];
  n1 -> n2;
  n1 -> n4;
  n2 -> n3 [color=green, penwidth=2.0];
  n4 -> n3 [color=green, penwidth=2.0];
  n5 -> n2;
  n5 -> n6;
  n6 -> n3 [color=green, penwidth=2.0];
  n7 -> n4;
  n7 -> n6;
}
