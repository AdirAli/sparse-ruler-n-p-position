digraph G {
  rankdir=TB;
  node [shape=box, fontsize=10];
  n0 [label="∅\nP", style=filled, fillcolor=lightblue];
  n1 [label="0\nN"];
  n2 [label="01\nP", style=filled, fillcolor=yellow];
  n3 [label="1\nN"];

  n0 -> n1;
  n0 -> n3;
  n1 -> n2 [color=green, penwidth=2.0];
  n3 -> n2 [color=green, penwidth=2.0];
}
